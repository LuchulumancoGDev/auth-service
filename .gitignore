################################################################################
# Global .gitignore for this auth-service repository
################################################################################

# Visual Studio / Rider / VS Code
.vs/
*.suo
*.user
*.userprefs
*.sln.doc
.vscode/

# Build results
**/bin/
**/obj/

# Publish output
**/publish/

# NuGet
# Packages
*.nupkg
# NuGet v2
packages/

# Rider
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Dotnet
project.lock.json
project.fragment.lock.json
artifacts/

# EntityFramework Migrations / EF Tools
*.Snapshot

# Logs
*.log

# Test results
TestResults/

# Lock files
global.json

# Ignore local user settings and temporary files
*.swp
*~

# Ensure we still ignore any explicit per-project files that can be large
AuthApi/obj/
AuthApi/bin/
Auth.Application/obj/
Auth.Application/bin/
Auth.Domain/obj/
Auth.Domain/bin/
Auth.Infrastructure/obj/
Auth.Infrastructure/bin/
